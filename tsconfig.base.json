{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@experts/config": ["packages/config/src/index.ts"],
      "@experts/contracts": ["packages/contracts/src/index.ts"],
      "@experts/ui": ["packages/ui/src/index.ts"],
      "@experts/ui/*": ["packages/ui/src/*"]
    }
  }
}
